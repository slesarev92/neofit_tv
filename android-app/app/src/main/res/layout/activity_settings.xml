<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_url"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_label_text_size"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_button_min_height"
            android:hint="@string/hint_server_url"
            android:textColor="@color/settings_text"
            android:textColorHint="@color/settings_text_hint"
            android:textSize="@dimen/settings_input_text_size"
            android:inputType="textUri"
            android:background="?android:attr/editTextBackground"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_id"
            android:textColor="@color/settings_text"
            android:textSize="@dimen/settings_label_text_size"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/editScreenId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_button_min_height"
            android:hint="@string/hint_screen_id"
            android:textColor="@color/settings_text"
            android:textColorHint="@color/settings_text_hint"
            android:textSize="@dimen/settings_input_text_size"
            android:inputType="text"
            android:background="?android:attr/editTextBackground"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_settings_hint"
            android:textColor="@color/settings_text_hint"
            android:textSize="@dimen/settings_hint_text_size"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCheckConnection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/settings_button_min_height"
                android:layout_weight="1"
                android:text="@string/check_connection"
                android:textSize="@dimen/settings_button_text_size"
                android:textColor="@color/settings_text"
                android:layout_marginEnd="8dp" />
            <Button
                android:id="@+id/btnChangePin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/settings_button_min_height"
                android:layout_weight="1"
                android:text="@string/change_pin"
                android:textSize="@dimen/settings_button_text_size"
                android:textColor="@color/settings_text" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveAndLaunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_button_min_height"
            android:text="@string/save_and_launch"
            android:textSize="@dimen/settings_button_text_size"
            android:backgroundTint="@color/settings_accent"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/settingsVersionFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/settings_text_hint"
            android:textSize="12sp"
            tools:text="NeoFit TV 1.0 (1)" />
    </LinearLayout>
</ScrollView>
